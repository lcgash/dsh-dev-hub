{
  "name": "dsh-dev-hub",
  "version": "0.1.0",
  "description": "Chat-first development flow tracker for DeepSeek Harness: scan, clarify, plan, review, test and report repository-aware changes.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "start": "node bin/devhub.mjs serve",
    "standalone": "npm run build && node bin/devhub.mjs serve"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "tsdown": "0.22.2",
    "typescript": "~5.7.2"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "developer-workflow",
    "code-review",
    "git-worktree",
    "context-pack"
  ],
  "files": [
    "lib",
    "src",
    "locale",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "LICENSE",
    "cordis.patch.yml",
    "bin"
  ],
  "bin": {
    "devhub": "./bin/devhub.mjs"
  }
}
